{
  "name": "bluebird",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @bluebird/web dev",
    "dev:api": "pnpm --filter @bluebird/api dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "db:up": "bash scripts/dev-db.sh up",
    "db:down": "bash scripts/dev-db.sh down",
    "db:status": "bash scripts/dev-db.sh status",
    "db:migrate": "pnpm --filter @bluebird/api db:migrate",
    "setup:keys": "node scripts/dev-keys.mjs",
    "bench:computer-use": "pnpm --filter @bluebird/api bench:computer-use"
  }
}
