{
  "name": "@bluebird/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:computer-use": "tsx --env-file-if-exists=.env src/bench/computer-use/cli.ts"
  },
  "dependencies": {
    "@bluebird/shared": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.1.2",
    "fastify": "^5.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "unpdf": "^1.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
