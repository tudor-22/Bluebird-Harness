# Port the API listens on. It binds to loopback only.
PORT=4000
HOST=127.0.0.1

# Browser origins allowed to call the API directly (development only).
WEB_ORIGINS=http://localhost:3000

# Postgres. `pnpm db:up` starts the local database these defaults point at.
DATABASE_URL=postgres://bluebird_app:bluebird_dev_password@127.0.0.1:5432/bluebird
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/bluebird

# Between the web app and this API: JSON map of kid -> public JWK.
# Generated by `pnpm setup:keys`.
BLUEBIRD_SERVICE_PUBLIC_KEYS=

# Models run in a local Ollama server and are detected automatically.
# "stub" streams an offline placeholder instead.
MODEL_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# Optional: force one model instead of choosing in the app.
BLUEBIRD_MODEL=
# Context window requested from Ollama. Raise it if you have the memory.
BLUEBIRD_CONTEXT_TOKENS=16384

# Retrieval and long-term memory use a local embedding model: ollama pull bge-m3
# Leave empty to switch retrieval off.
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3

# Place lookup for maps leaves this machine, so it is off unless set to 1.
BLUEBIRD_ALLOW_ONLINE=

# Where uploaded attachments are stored on disk (created on demand).
ATTACHMENTS_DIR=.data/attachments

# Seals attachment bytes at rest (32 base64-encoded bytes); `pnpm setup:keys`
# generates it once. Keep it: sealed attachments cannot be read without it.
BLUEBIRD_CONTENT_KEY=
